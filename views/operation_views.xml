
<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Operation Tree View -->
    <record id="view_operation_tree" model="ir.ui.view">
        <field name="name">stocksense.operation.tree</field>
        <field name="model">stocksense.operation</field>
        <field name="arch" type="xml">
            <tree string="Inventory Operations"
                  decoration-info="state == 'draft'"
                  decoration-warning="state == 'confirmed'"
                  decoration-success="state == 'done'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="operation_type"/>
                <field name="adjustment_type"
                       invisible="operation_type != 'adjustment'"/>
                <field name="product_id" string="Primary Product"/>
                <field name="quantity" string="Total Quantity"/>
                <field name="uom"/>
                <field name="source_location_id"/>
                <field name="destination_location_id"/>
                <field name="date"/>
                <field name="responsible_user_id"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'confirmed'"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <!-- Operation Form View -->
    <record id="view_operation_form" model="ir.ui.view">
        <field name="name">stocksense.operation.form</field>
        <field name="model">stocksense.operation</field>
        <field name="arch" type="xml">
            <form string="Inventory Operation">
                <header>
                    <button name="action_confirm"
                            string="Confirm"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_validate"
                            string="Validate"
                            type="object"
                            class="btn-primary"
                            invisible="state not in ['draft', 'confirmed']"/>

                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            invisible="state in ['done', 'cancelled']"/>

                    <button name="action_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state != 'cancelled'"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,confirmed,done"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button"
                                icon="fa-exchange"
                                name="action_view_movements"
                                type="object"
                                invisible="movement_count == 0">
                            <field name="movement_count"
                                   string="Movements"
                                   widget="statinfo"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Operation Details">
                            <field name="operation_type"
                                   readonly="state != 'draft'"/>
                            <field name="adjustment_type"
                                   invisible="operation_type != 'adjustment'"
                                   required="operation_type == 'adjustment'"
                                   readonly="state != 'draft'"/>
                            <field name="product_id"
                                   readonly="state != 'draft'"/>
                            <field name="quantity"
                                   readonly="state != 'draft'"/>
                            <field name="uom"/>
                            <field name="partner_name"
                                   invisible="operation_type not in ['receipt', 'delivery']"
                                   readonly="state != 'draft'"/>
                        </group>

                        <group string="Locations">
                            <field name="source_location_id"
                                   readonly="state != 'draft'"
                                   invisible="operation_type == 'receipt' or (operation_type == 'adjustment' and adjustment_type == 'gain')"
                                   required="operation_type in ['delivery', 'internal'] or (operation_type == 'adjustment' and adjustment_type == 'loss')"/>

                            <field name="destination_location_id"
                                   readonly="state != 'draft'"
                                   invisible="operation_type == 'delivery' or (operation_type == 'adjustment' and adjustment_type == 'loss')"
                                   required="operation_type in ['receipt', 'internal'] or (operation_type == 'adjustment' and adjustment_type == 'gain')"/>
                        </group>
                    </group>

                    <group>
                        <group string="Scheduling">
                            <field name="date"
                                   readonly="state != 'draft'"/>
                            <field name="date_done" readonly="1"/>
                            <field name="responsible_user_id"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group string="Additional Info">
                            <field name="partner_name"
                                   readonly="state != 'draft'"
                                   invisible="operation_type not in ['receipt', 'delivery']"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Products &amp; Quantities">
                            <field name="line_ids"
                                   readonly="state != 'draft'">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="uom"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Reason / Notes">
                            <field name="reason"
                                   readonly="state != 'draft'"
                                   placeholder="Describe the reason for this operation..."/>
                        </page>

                        <page string="Movements"
                              invisible="movement_count == 0">
                            <field name="movement_ids" readonly="1">
                                <tree>
                                    <field name="date"/>
                                    <field name="movement_type"/>
                                    <field name="product_id"/>
                                    <field name="source_location_id"/>
                                    <field name="destination_location_id"/>
                                    <field name="quantity"/>
                                    <field name="uom"/>
                                    <field name="user_id"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Operation Search View -->
    <record id="view_operation_search" model="ir.ui.view">
        <field name="name">stocksense.operation.search</field>
        <field name="model">stocksense.operation</field>
        <field name="arch" type="xml">
            <search string="Search Operations">
                <field name="name"
                       filter_domain="['|', '|', ('name', 'ilike', self), ('product_sku', 'ilike', self), ('partner_name', 'ilike', self)]"/>
                <field name="product_id"/>
                <field name="product_sku"/>
                <field name="product_category_id"/>
                <field name="partner_name"/>
                <field name="source_location_id"/>
                <field name="destination_location_id"/>
                <field name="source_warehouse_id"/>
                <field name="destination_warehouse_id"/>
                <field name="responsible_user_id"/>

                <separator/>

                <filter string="Receipts"
                        name="receipts"
                        domain="[('operation_type', '=', 'receipt')]"/>
                <filter string="Deliveries"
                        name="deliveries"
                        domain="[('operation_type', '=', 'delivery')]"/>
                <filter string="Internal Transfers"
                        name="transfers"
                        domain="[('operation_type', '=', 'internal')]"/>
                <filter string="Adjustments"
                        name="adjustments"
                        domain="[('operation_type', '=', 'adjustment')]"/>

                <filter string="Stock Gain"
                        name="gain_adjustments"
                        domain="[('operation_type', '=', 'adjustment'), ('adjustment_type', '=', 'gain')]"/>
                <filter string="Stock Loss"
                        name="loss_adjustments"
                        domain="[('operation_type', '=', 'adjustment'), ('adjustment_type', '=', 'loss')]"/>

                <separator/>

                <filter string="Draft"
                        name="draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed"
                        name="confirmed"
                        domain="[('state', '=', 'confirmed')]"/>
                <filter string="Done"
                        name="done"
                        domain="[('state', '=', 'done')]"/>
                <filter string="Cancelled"
                        name="cancelled"
                        domain="[('state', '=', 'cancelled')]"/>

                <separator/>

                <filter string="Today"
                        name="today"
                        domain="[('date', '&gt;=', (context_today()).strftime('%Y-%m-%d')), ('date', '&lt;', (context_today() + datetime.timedelta(days=1)).strftime('%Y-%m-%d'))]"/>
                <filter string="Yesterday"
                        name="yesterday"
                        domain="[('date', '&gt;=', (context_today() - datetime.timedelta(days=1)).strftime('%Y-%m-%d')), ('date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="This Week"
                        name="this_week"
                        domain="[('date', '&gt;=', (context_today() - datetime.timedelta(days=context_today().weekday())).strftime('%Y-%m-%d'))]"/>
                <filter string="This Month"
                        name="this_month"
                        domain="[('date', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <filter string="This Year"
                        name="this_year"
                        domain="[('date', '&gt;=', context_today().strftime('%Y-01-01'))]"/>

                <group expand="0" string="Group By">
                    <filter string="Type"
                            name="group_type"
                            context="{'group_by': 'operation_type'}"/>
                    <filter string="Adjustment Direction"
                            name="group_adjustment_type"
                            context="{'group_by': 'adjustment_type'}"/>
                    <filter string="Status"
                            name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Product"
                            name="group_product"
                            context="{'group_by': 'product_id'}"/>
                    <filter string="Category"
                            name="group_category"
                            context="{'group_by': 'product_category_id'}"/>
                    <filter string="Source Location"
                            name="group_source_loc"
                            context="{'group_by': 'source_location_id'}"/>
                    <filter string="Destination Location"
                            name="group_dest_loc"
                            context="{'group_by': 'destination_location_id'}"/>
                    <filter string="Source Warehouse"
                            name="group_source_wh"
                            context="{'group_by': 'source_warehouse_id'}"/>
                    <filter string="Destination Warehouse"
                            name="group_dest_wh"
                            context="{'group_by': 'destination_warehouse_id'}"/>
                    <filter string="Scheduled Date"
                            name="group_date"
                            context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Operation Actions (by type) -->
    <record id="action_operation_all" model="ir.actions.act_window">
        <field name="name">All Operations</field>
        <field name="res_model">stocksense.operation</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_operation_search"/>
    </record>

    <record id="action_operation_receipt" model="ir.actions.act_window">
        <field name="name">Receipts</field>
        <field name="res_model">stocksense.operation</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('operation_type', '=', 'receipt')]</field>
        <field name="context">{'default_operation_type': 'receipt'}</field>
        <field name="search_view_id" ref="view_operation_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new receipt
            </p>
            <p>Record incoming goods from suppliers.</p>
        </field>
    </record>

    <record id="action_operation_delivery" model="ir.actions.act_window">
        <field name="name">Deliveries</field>
        <field name="res_model">stocksense.operation</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('operation_type', '=', 'delivery')]</field>
        <field name="context">{'default_operation_type': 'delivery'}</field>
        <field name="search_view_id" ref="view_operation_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new delivery
            </p>
            <p>Record outgoing goods to customers.</p>
        </field>
    </record>

    <record id="action_operation_internal" model="ir.actions.act_window">
        <field name="name">Internal Transfers</field>
        <field name="res_model">stocksense.operation</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('operation_type', '=', 'internal')]</field>
        <field name="context">{'default_operation_type': 'internal'}</field>
        <field name="search_view_id" ref="view_operation_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new internal transfer
            </p>
            <p>Move stock between locations within your warehouses.</p>
        </field>
    </record>

    <record id="action_operation_adjustment" model="ir.actions.act_window">
        <field name="name">Adjustments</field>
        <field name="res_model">stocksense.operation</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('operation_type', '=', 'adjustment')]</field>
        <field name="context">{'default_operation_type': 'adjustment'}</field>
        <field name="search_view_id" ref="view_operation_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new inventory adjustment
            </p>
            <p>Correct stock levels after physical counts or for loss/damage.</p>
        </field>
    </record>

    <!-- Recent operation lists -->
    <record id="action_operation_recent_receipts"
            model="ir.actions.act_window">
        <field name="name">Recent Receipts</field>
        <field name="res_model">stocksense.operation</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('operation_type', '=', 'receipt')]</field>
        <field name="context">{'default_operation_type': 'receipt'}</field>
        <field name="search_view_id" ref="view_operation_search"/>
        <field name="limit">10</field>
    </record>

    <record id="action_operation_recent_deliveries"
            model="ir.actions.act_window">
        <field name="name">Recent Deliveries</field>
        <field name="res_model">stocksense.operation</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('operation_type', '=', 'delivery')]</field>
        <field name="context">{'default_operation_type': 'delivery'}</field>
        <field name="search_view_id" ref="view_operation_search"/>
        <field name="limit">10</field>
    </record>

    <record id="action_operation_recent_transfers"
            model="ir.actions.act_window">
        <field name="name">Recent Internal Transfers</field>
        <field name="res_model">stocksense.operation</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('operation_type', '=', 'internal')]</field>
        <field name="context">{'default_operation_type': 'internal'}</field>
        <field name="search_view_id" ref="view_operation_search"/>
        <field name="limit">10</field>
    </record>

</odoo>