<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Sequence: Receipt Operations -->
        <record id="sequence_operation_receipt" model="ir.sequence">
            <field name="name">StockSense Receipt</field>
            <field name="code">stocksense.operation.receipt</field>
            <field name="prefix">REC/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence: Delivery Operations -->
        <record id="sequence_operation_delivery" model="ir.sequence">
            <field name="name">StockSense Delivery</field>
            <field name="code">stocksense.operation.delivery</field>
            <field name="prefix">DEL/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence: Internal Transfers -->
        <record id="sequence_operation_internal" model="ir.sequence">
            <field name="name">StockSense Internal Transfer</field>
            <field name="code">stocksense.operation.internal</field>
            <field name="prefix">INT/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence: Adjustments -->
        <record id="sequence_operation_adjustment" model="ir.sequence">
            <field name="name">StockSense Adjustment</field>
            <field name="code">stocksense.operation.adjustment</field>
            <field name="prefix">ADJ/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
